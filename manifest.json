{
  "manifest_version": 3,
  "name": "Wera: job applications",
  "short_name": "Wera",
  "version": "0.0.0",
  "description": "Save jobs to Wera, see your fit, write cover letters, tailor your resume and fill applications. You review and submit.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Wera",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open Wera"
    },
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this application"
    }
  }
}
